# Copy this file to `.env` and fill in the blank values below.
# `.env` is gitignored -- never commit it, never paste a key into chat or a PR.
#
# Testnet keys only. Nothing here is audited or intended for mainnet funds.
# See README.md "Honest limitations".

# ─── Required: fill these in ───────────────────────────────────────────────

# Signs the facilitator's on-chain settlement transactions on Base Sepolia.
# Needs a small amount of Base Sepolia testnet ETH for gas (this wallet pays
# gas on the payer's behalf, which is what makes a payment gasless for the
# payer). Get a throwaway key (e.g. `cast wallet new`) and fund it from
# https://www.alchemy.com/faucets/base-sepolia
FACILITATOR_PRIVATE_KEY=

# Signs EIP-3009 payment authorizations -- only needed to run `npm run pay`
# (the payer side), not to run the server itself. Needs Base Sepolia testnet
# USDC (not ETH -- the payer never submits a transaction). Get testnet USDC
# from Circle's faucet: https://faucet.circle.com (select Base Sepolia).
PAYER_PRIVATE_KEY=

# A Hedera testnet account that submits HCS journal messages. Create one free
# at https://portal.hedera.com -- it auto-funds with testnet HBAR.
HEDERA_ACCOUNT_ID=

# That account's private key. A fresh account from the Hedera portal is
# typically ECDSA, DER-encoded (starts `3030020100300706...`) -- this
# template loads it with `PrivateKey.fromStringDer()`, which handles that
# format correctly. Loading a DER key the wrong way (ED25519) silently
# derives a different key and every HCS submission fails with
# INVALID_SIGNATURE.
HEDERA_PRIVATE_KEY=

# Shared secret the middleware uses to derive and validate payment
# challenges with zero storage (an HMAC key, not a wallet key). Must be
# >= 32 bytes and identical across every process serving this merchant.
# Generate with:
#   openssl rand -hex 32
FERRY402_SECRET=

# ─── Already filled in: the deployed infrastructure this template targets ──
# These are not secrets. They point at a live, already-deployed Base Sepolia
# Escrow contract and a live Hedera testnet HCS topic -- see README.md
# "What's already deployed" for the verified transaction history. You do not
# need to deploy anything to get this scaffold running. Override them only if
# you deploy your own Escrow / topic (see README.md "Deploy your own").

# Public RPC endpoint.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# The deployed, non-custodial Escrow contract this scaffold settles into.
ESCROW_ADDRESS_BASE_SEPOLIA=0x99Cd564B21fa7fD8553Cf31F32E448C17BBcC429

# Circle USDC on Base Sepolia (6 decimals). This is `Escrow.token()`.
USDC_ADDRESS_BASE_SEPOLIA=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# The EVM address this merchant gets credited at inside the Escrow contract's
# internal ledger. Defaults to the example merchant used throughout this
# template's docs so the scaffold runs with zero changes -- swap in your own
# address (any EVM address works; it needs no funding or deployed code) once
# you're past the quickstart.
MERCHANT_EVM_ADDRESS=0x86eEa3B06E6994eaF8Ce3Fcfde6A2F8Fb2Ba947b

# The HCS topic every settled payment is journaled to. This is the live
# shared demo topic (https://hashscan.io/testnet/topic/0.0.10719807) -- its
# submit_key is null, so anyone may write to it, which is exactly what makes
# the zero-config quickstart possible. Journal entries are only meaningful
# once filtered by `merchantEvm` (see README.md), so sharing the topic with
# other scaffold users does not corrupt your own reconciliation. Create your
# own topic for a real deployment -- see README.md "Deploy your own".
HCS_TOPIC_ID=0.0.10719807

# ─── Ports ──────────────────────────────────────────────────────────────────

# The merchant API's port.
PORT=3000

# The facilitator's port. `npm run dev` runs both in one process; the merchant
# calls the facilitator over loopback at this port.
FACILITATOR_PORT=4000
