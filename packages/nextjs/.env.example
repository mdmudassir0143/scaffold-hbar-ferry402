# Optional. Every value below already defaults to the shared testnet
# deployment the API package targets, so the dashboard runs with no .env at
# all. Copy to .env.local only to point it at your own escrow, merchant or
# topic -- and keep these in step with packages/api/.env.
# None of these are secrets: the dashboard is read-only and holds no keys.

# Where packages/api is listening (`npm run dev` at the repo root).
API_URL=http://localhost:3001

BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ESCROW_ADDRESS_BASE_SEPOLIA=0x99Cd564B21fa7fD8553Cf31F32E448C17BBcC429
MERCHANT_EVM_ADDRESS=0x86eEa3B06E6994eaF8Ce3Fcfde6A2F8Fb2Ba947b
HCS_TOPIC_ID=0.0.10719807
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
